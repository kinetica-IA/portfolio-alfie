---
// Three competencies, each with one line of evidence and a link to its case.
import profile from '../../data/profile.en.json'
---
<section class="section competencies" aria-labelledby="competencies-title">
  <p class="eyebrow comp-eyebrow">What I work on</p>
  <h2 id="competencies-title" class="comp-title">Three skills, each with a project behind it.</h2>
  <ol class="comp-list">
    {profile.competencies.map((c, i) => (
      <li class="comp-item">
        <span class="comp-num" aria-hidden="true">0{i + 1}</span>
        <div>
          <h3 class="comp-name">{c.title}</h3>
          <p class="comp-evidence">{c.evidence}</p>
          <a class="comp-link" href={`/projects/${c.project}/`}>{c.linkLabel} <span aria-hidden="true">→</span></a>
        </div>
      </li>
    ))}
  </ol>
  <p class="comp-all"><a href="/projects/">All four projects <span aria-hidden="true">→</span></a></p>
</section>

<style>
  .comp-eyebrow { color: var(--teal-text); font-size: var(--text-caption); }
  .comp-title {
    font-family: var(--sans);
    font-size: var(--text-section);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-heading);
    margin: 12px 0 var(--space-subsection);
    max-width: 24ch;
  }
  .comp-list {
    list-style: none;
    border-top: 1px solid var(--border-active);
  }
  .comp-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-active);
  }
  .comp-num {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--teal-text);
    padding-top: 2px;
  }
  .comp-name {
    font-family: var(--sans);
    font-size: var(--text-subsection);
    font-weight: 400;
    line-height: 1.3;
    color: var(--text-heading);
    margin-bottom: 8px;
  }
  .comp-evidence {
    font-size: var(--text-body);
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-sec);
    max-width: 640px;
    margin-bottom: 8px;
  }
  .comp-link, .comp-all a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-family: var(--mono);
    font-size: var(--text-caption);
  }
  .comp-all { margin-top: 12px; }
  @media (max-width: 480px) {
    .comp-item { grid-template-columns: 28px 1fr; gap: 12px; }
  }
</style>
