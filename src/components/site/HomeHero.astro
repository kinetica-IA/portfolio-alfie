---
// English home hero: role, headline, subtitle, availability and the two CTAs.
// Static Astro markup: no rotating text, no entrance animation, no aria-live.
import profile from '../../data/profile.en.json'
import Availability from './Availability.astro'
---
<section class="hero home-hero" aria-labelledby="home-title">
  <p class="home-eyebrow">{profile.role} · {profile.level}</p>
  <p class="home-wordmark" aria-hidden="true">KINETICAAI</p>
  <h1 id="home-title" class="home-title">{profile.headline}</h1>
  <p class="home-subtitle">{profile.subtitle}</p>
  <h2 class="visually-hidden">Availability</h2>
  <Availability compact />
  <div class="home-cta">
    <a href="/projects/" class="btn btn--primary">See projects</a>
    <a href="/contact/" class="btn btn--secondary">Contact</a>
  </div>
</section>

<style>
  .home-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: calc(var(--header-h) + 40px) 0 var(--space-section);
    min-height: min(88vh, 760px);
    justify-content: center;
  }
  .home-eyebrow {
    font-family: var(--mono);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sea-text);
    margin-bottom: 12px;
  }
  .home-wordmark {
    font-family: var(--sans);
    font-size: var(--text-hero);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--text-heading);
    text-shadow: 0 1px 3px rgba(36, 64, 60, 0.05);
    max-width: 100%;
  }
  .home-title {
    font-family: var(--sans);
    font-size: clamp(1.5rem, 4.2vw, 2.25rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--text-heading);
    margin: 16px 0 14px;
    max-width: 22ch;
  }
  .home-subtitle {
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-sec);
    max-width: 620px;
    margin-bottom: 20px;
  }
  .home-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 28px;
  }
  @media (max-width: 480px) {
    .home-hero { padding-top: calc(var(--header-h) + 24px); min-height: 0; }
    .home-subtitle { margin-bottom: 16px; }
    .home-cta { flex-direction: column; align-items: stretch; width: 100%; margin-top: 22px; }
  }
</style>
