---
// 404 — English first (root language), with a Spanish line for clinical visitors.
import Layout from '../layouts/Layout.astro'
---
<Layout title="Page not found" lang="en" ogImage="/og/home.png">
  <section class="section notfound-page">
    <span class="eyebrow" style="color: var(--clay-text)">404</span>
    <h1 class="notfound-title">Page not found</h1>
    <p class="notfound-message">
      This page does not exist or has moved. The English pages are at the root; the Spanish clinical pages are under /es/.
    </p>
    <div class="notfound-links">
      <a href="/" class="notfound-link">Home</a>
      <a href="/projects/" class="notfound-link">Projects</a>
      <a href="/contact/" class="notfound-link">Contact</a>
    </div>
    <div lang="es">
      <p class="notfound-message notfound-es">
        Página no encontrada. El contenido clínico en español está en /es/.
      </p>
      <div class="notfound-links">
        <a href="/es/" class="notfound-link" hreflang="es">Inicio (español)</a>
        <a href="/es/informes/" class="notfound-link" hreflang="es">Informes</a>
        <a href="/es/about/" class="notfound-link" hreflang="es">Sobre mí</a>
      </div>
    </div>
  </section>

  <style>
    .notfound-page {
      display: flex;
      flex-direction: column;
      max-width: 560px;
    }
    .notfound-title {
      font-family: var(--sans);
      font-size: var(--text-section);
      font-weight: 400;
      color: var(--text-heading);
      margin: 16px 0 var(--space-element);
    }
    .notfound-message {
      font-size: var(--text-body);
      font-weight: 300;
      color: var(--text-sec);
      line-height: 1.75;
      margin-bottom: var(--space-subsection);
    }
    .notfound-links {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
    }
    .notfound-es { margin-top: var(--space-subsection); margin-bottom: 12px; }
    .notfound-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-family: var(--mono);
      font-size: var(--text-caption);
      color: var(--text-dim);
      border-bottom: 1px solid var(--border);
      padding-bottom: 2px;
      transition: color var(--duration-hover) ease, border-color var(--duration-hover) ease;
    }
    .notfound-link:hover {
      color: var(--green-text);
      border-color: var(--green-text);
    }
  </style>
</Layout>
