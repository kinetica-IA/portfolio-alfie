---
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'

const KIND_LABEL = {
  'n-of-1': 'N-DE-1',
  'essay': 'ENSAYO',
  'coursera-derived': 'FORMACIÓN',
}

export async function getStaticPaths() {
  const entries = (await getCollection('lab')).filter(e => !e.data.draft && !e.data.external_route)
  return entries.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---
<Layout title={entry.data.title} description={entry.data.summary}>
  <article class="section lab-entry-page">
    <span class="eyebrow" style="color: var(--teal)">{KIND_LABEL[entry.data.kind] ?? entry.data.kind}</span>
    <h1 class="lab-entry-title">{entry.data.title}</h1>
    {entry.data.kind === 'n-of-1' && (
      <p class="lab-entry-note">Auto-observación n-de-1. No es un ensayo clínico ni un producto diagnóstico.</p>
    )}
    <div class="lab-entry-prose">
      <Content />
    </div>
    <a href="/lab" class="lab-entry-back">← Volver al lab</a>
  </article>

  <style>
    .lab-entry-page {
      display: flex;
      flex-direction: column;
      max-width: 680px;
    }
    .lab-entry-title {
      font-family: var(--sans);
      font-size: var(--text-section);
      font-weight: 400;
      color: var(--text-heading);
      margin: 16px 0 12px;
    }
    .lab-entry-note {
      font-family: var(--mono);
      font-size: var(--text-caption);
      color: var(--text-dim);
      margin-bottom: var(--space-element);
    }
    .lab-entry-prose {
      font-size: var(--text-body);
      font-weight: 300;
      color: var(--text-sec);
      line-height: 1.75;
    }
    .lab-entry-prose :global(p) {
      margin: 0 0 18px;
    }
    .lab-entry-prose :global(.artefacto-embed) {
      margin: 0 0 18px;
    }
    .lab-entry-back {
      margin-top: var(--space-subsection);
      font-family: var(--mono);
      font-size: var(--text-caption);
      color: var(--text-dim);
    }
    .lab-entry-back:hover { color: var(--teal); }
  </style>
</Layout>
