---
// / — English home for employers (lang="en"). The Spanish clinical home
// moved to /es/ (src/pages/es/index.astro).
// Order: hero (role, availability, See projects / Contact) → three
// competencies with evidence → contact. Detailed limits live in each case.
import Layout from '../layouts/Layout.astro'
import HomeHero from '../components/site/HomeHero.astro'
import Competencies from '../components/site/Competencies.astro'
import ContactBlock from '../components/site/ContactBlock.astro'
---

<Layout
  lang="en"
  alternates={{ en: '/', es: '/es/' }}
  ogImage="/og/home.png"
>
  <HomeHero />
  <Competencies />
  <ContactBlock id="contact" showAvailability={false} />
</Layout>
