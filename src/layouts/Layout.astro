---
// src/layouts/Layout.astro
import GrainHoverBackground from '../components/GrainHoverBackground.jsx'
import { FloatingDecorators } from '../components/OrganicSymbols.jsx'
import TopBar from '../components/TopBar.jsx'
import FooterField from '../components/FooterField.jsx'
import ClientRouter from 'astro/components/ClientRouter.astro'
import '../styles/tokens.css'

interface Props {
  title?: string
}

const { title } = Astro.props
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f0f9f9" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- SEO -->
    <title>{title ? `${title} — Kinetica AI` : 'Kinetica AI — Osteopatía y biomecánica'}</title>
    <meta name="description" content="Osteópata D.O. Registre de France. Consulta clínica y biomecánica en Alameda (Málaga) y a domicilio en radio superior a 100 km." />
    <meta name="author" content="Alfonso Navarro" />
    <link rel="canonical" href="https://www.kineticaai.com" />

    <!-- Open Graph -->
    <meta property="og:title" content="Kinetica AI — Osteopatía y biomecánica" />
    <meta property="og:description" content="Osteópata D.O. Registre de France. Consulta clínica y biomecánica en Alameda (Málaga) y a domicilio en radio superior a 100 km." />
    <meta property="og:image" content="https://www.kineticaai.com/og-image.jpg" />
    <meta property="og:url" content="https://www.kineticaai.com" />
    <meta property="og:type" content="website" />

    <!-- Schema.org -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "name": "Kinetica AI",
      "url": "https://www.kineticaai.com",
      "email": "alfon.atman@gmail.com",
      "medicalSpecialty": "PhysicalTherapy",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Alameda",
        "addressRegion": "Málaga",
        "addressCountry": "ES"
      },
      "founder": {
        "@type": "Person",
        "name": "Alfonso Navarro",
        "jobTitle": "Osteópata D.O.",
        "identifier": {
          "@type": "PropertyValue",
          "propertyID": "RPPS",
          "value": "10010607702"
        }
      }
    }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "165f6fd632de46bb905ef551de19e2d1"}'></script><!-- End Cloudflare Web Analytics -->
  </head>
  <body>
    <GrainHoverBackground client:only="react" transition:persist="ambient-bg" />
    <FloatingDecorators client:load transition:persist="floating-deco" />
    <TopBar client:load transition:persist="topbar" />
    <div class="content-layer">
      <slot />
    </div>
    <FooterField />

    <!-- Analytics (GoatCounter — privacy-first, no cookies) -->
    <script data-goatcounter="https://kineticaai.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>

    <style>
      .content-layer {
        position: relative;
        z-index: 1;
        max-width: 960px;
        margin: 0 auto;
        padding: 0 48px;
      }
      @media (max-width: 768px) {
        .content-layer { padding: 0 20px; }
      }
      @media (max-width: 420px) {
        .content-layer { padding: 0 16px; }
      }
    </style>
  </body>
</html>
